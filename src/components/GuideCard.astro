---
import type { Guide } from '../lib/types';
import { whatsappUrl } from '../lib/whatsapp';

interface Props { guide: Guide }
const { guide } = Astro.props;

const initials = guide.full_name.split(' ').filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
const rated = guide.avg_rating !== null && guide.reviews_count > 0;
---
<article class="flex h-full flex-col rounded-2xl border border-navy-100 bg-white p-5">
  <div class="flex items-start gap-4">
    {guide.photo_url ? (
      <img src={guide.photo_url} alt={`Foto de ${guide.full_name}`} width="64" height="64" loading="lazy"
           class="size-16 shrink-0 rounded-full object-cover" />
    ) : (
      <div role="img" aria-label={`Sin foto: iniciales de ${guide.full_name}`}
           class="flex size-16 shrink-0 items-center justify-center rounded-full bg-navy-700 font-display text-xl font-bold text-white">
        {initials}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <h3 class="text-lg font-bold leading-snug"><a href={`/guias/${guide.id}`} class="hover:underline">{guide.full_name}</a></h3>
      <p class="text-sm text-navy-900/75">Carné {guide.carnet}</p>
      <p class="text-sm text-navy-900/75">RNT {guide.rnt}</p>
    </div>
  </div>

  <p class="mt-3 flex items-center gap-1.5 text-sm font-semibold" aria-label={rated ? `Puntuación ${guide.avg_rating} de 5` : 'Aún sin reseñas'}>
    <svg viewBox="0 0 20 20" class="size-5 text-sol-600" fill="currentColor" aria-hidden="true">
      <path d="M10 1.5l2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L1.4 7.8l6-.8z" />
    </svg>
    {rated ? (<><span>{guide.avg_rating!.toFixed(1)} / 5</span><span class="font-normal text-navy-900/70">({guide.reviews_count})</span></>)
           : (<span class="font-normal text-navy-900/70">Aún sin reseñas</span>)}
  </p>

  <dl class="mt-4 mb-5 space-y-2 text-sm">
    <div class="flex flex-wrap items-center gap-1.5">
      <dt class="sr-only">Idiomas</dt>
      {guide.languages.map((l) => <dd class="rounded-md bg-navy-100 px-2 py-0.5 font-medium text-navy-700">{l}</dd>)}
    </div>
    <div class="flex flex-wrap items-center gap-1.5">
      <dt class="sr-only">Especialidades</dt>
      {guide.specialties.map((s) => <dd class="rounded-md bg-magenta-100 px-2 py-0.5 font-medium text-magenta-700">{s}</dd>)}
    </div>
    <div class="flex items-center gap-1.5">
      <dt class="sr-only">Departamento de cobertura</dt>
      <dd class="inline-flex items-center gap-1 rounded-md border border-navy-100 px-2 py-0.5">
        <svg viewBox="0 0 20 20" class="size-4" fill="currentColor" aria-hidden="true"><path d="M10 1.5a6 6 0 00-6 6c0 4.2 6 11 6 11s6-6.800 6-11a6 6 0 00-6-6zm0 8.200a2.200 2.200 0 110-4.400 2.200 2.200 0 010 4.400z"/></svg>
        {guide.department}
      </dd>
    </div>
  </dl>

  <a href={whatsappUrl(guide.whatsapp)} target="_blank" rel="noopener noreferrer"
     onclick={`trackWhatsAppClick('${guide.id}')`}
     class="inline-flex items-center justify-center gap-2 rounded-xl bg-wa px-4 py-3 text-sm font-semibold text-white hover:bg-wa-hover mt-auto">
    <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.600 15L2 22l5.200-1.400A10 10 0 1012 2zm0 18.200a8.200 8.200 0 01-4.200-1.200l-.3-.2-3 .8.8-2.900-.2-.3A8.200 8.200 0 1112 20.200zm4.500-6.100c-.2-.1-1.500-.7-1.700-.8-.2-.1-.4-.1-.6.100l-.8 1c-.1.200-.3.200-.5.100a6.700 6.700 0 01-3.300-2.900c-.2-.4.200-.4.700-1.300.1-.2 0-.3 0-.5l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.300 3 3 0 00-.9 2.200 5.200 5.200 0 001.100 2.800 11.900 11.900 0 004.600 4c1.700.7 2.400.8 3.200.7a2.700 2.700 0 001.800-1.300c.2-.5.200-.9.200-1.300-.1-.1-.3-.2-.5-.3z"/></svg>
    Escribir por WhatsApp
  </a>
</article>
