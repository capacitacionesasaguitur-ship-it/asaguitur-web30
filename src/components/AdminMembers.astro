---
interface Props { members: any[] }
const { members } = Astro.props;
const money = new Intl.NumberFormat('es-SV', { style: 'currency', currency: 'USD' });
const FIN: Record<string, { t: string; c: string }> = {
  al_dia: { t: 'Al día', c: 'bg-vigente text-white' },
  pendiente: { t: 'Pendiente', c: 'bg-sol-400 text-navy-900' },
  en_mora: { t: 'En mora', c: 'bg-novigente text-white' },
};
const inp = 'w-full rounded-lg border border-navy-900/25 bg-white px-2.5 py-1.5';
---
<div>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="w-full sm:w-80">
      <label for="m-q" class="block text-sm font-semibold">Buscar socio</label>
      <input id="m-q" type="search" placeholder="Nombre, carné o correo" autocomplete="off" class={`mt-1 ${inp}`} />
    </div>
    <p id="m-count" class="text-sm font-semibold"></p>
  </div>
  <p id="m-status" role="status" aria-live="polite" class="mt-3 min-h-5 text-sm"></p>

  <div class="mt-2 overflow-x-auto rounded-2xl border border-navy-100 bg-white">
    <table class="w-full min-w-[900px] text-left text-sm">
      <thead class="border-b border-navy-100 text-navy-900/75">
        <tr>
          <th scope="col" class="px-3 py-2.5 font-semibold">Socio</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Correo</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Saldo vencido</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Cuenta</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Alta / baja</th>
          <th scope="col" class="px-3 py-2.5"><span class="sr-only">Guardar</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-navy-100">
        {members.map((m) => (
          <tr data-member data-id={m.id} data-name={m.full_name} data-search={`${m.full_name} ${m.carnet} ${m.email ?? ''}`}>
            <td class="px-3 py-2.5"><p class="font-semibold">{m.full_name}</p><p class="text-xs text-navy-900/70">Carné {m.carnet}{!m.user_id && ' (sin usuario en el portal)'}</p></td>
            <td class="px-3 py-2.5"><input type="email" data-f="email" value={m.email ?? ''} aria-label={`Correo de ${m.full_name}`} placeholder="correo@dominio.com" class={inp} /></td>
            <td class="px-3 py-2.5 font-semibold">{money.format(Number(m.saldo_vencido))}<p class="text-xs font-normal text-navy-900/70">{m.meses_mora} cuota(s) vencida(s)</p></td>
            <td class="px-3 py-2.5"><span class={`inline-block rounded-full px-2.5 py-1 text-xs font-bold ${FIN[m.finance_status].c}`}>{FIN[m.finance_status].t}</span>{m.estado === 'inactivo_mora' && <p class="mt-1 text-xs font-semibold text-novigente">Inactivo por mora</p>}{m.estado === 'pendiente' && <p class="mt-1 text-xs font-semibold">Pendiente de activación</p>}</td>
            <td class="px-3 py-2.5">
              <button type="button" role="switch" data-active aria-checked={String(m.estado === 'activo' || m.estado === 'inactivo_mora')} aria-label={`Socio dado de alta: ${m.full_name}`} title="Encendido = socio activo (al encenderlo, un socio pendiente se activa). Apagado = baja."
                      class="group relative h-7 w-12 rounded-full bg-navy-900/30 transition-colors aria-checked:bg-vigente">
                <span class="absolute left-0.5 top-0.5 size-6 rounded-full bg-white transition-transform group-aria-checked:translate-x-5"></span>
              </button>
            </td>
            <td class="px-3 py-2.5"><button type="button" data-save class="rounded-lg bg-navy-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-navy-900 disabled:opacity-60">Guardar</button></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import { postJson } from '../lib/admin-client';

  const rows = [...document.querySelectorAll<HTMLElement>('[data-member]')];
  const status = document.getElementById('m-status')!;
  const say = (msg: string, err = false) => { status.textContent = msg; status.className = `mt-3 min-h-5 text-sm font-semibold ${err ? 'text-novigente' : 'text-vigente'}`; };
  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  const q = document.getElementById('m-q') as HTMLInputElement;
  const count = document.getElementById('m-count')!;
  const filter = () => {
    const t = norm(q.value); let n = 0;
    rows.forEach((r) => { const ok = !t || norm(r.dataset.search ?? '').includes(t); r.classList.toggle('hidden', !ok); if (ok) n++; });
    count.textContent = `${n} de ${rows.length} socios`;
  };
  q.addEventListener('input', filter); filter();

  rows.forEach((row) => {
    const id = row.dataset.id!, name = row.dataset.name!;
    const email = row.querySelector<HTMLInputElement>('[data-f=email]')!;
    const sw = row.querySelector<HTMLButtonElement>('[data-active]')!;
    const saveBtn = row.querySelector<HTMLButtonElement>('[data-save]')!;

    sw.addEventListener('click', async () => {
      const next = sw.getAttribute('aria-checked') !== 'true';
      let motivo = '';
      if (!next) {
        const r = prompt(`Dar de baja a ${name}.\n\nSu carné digital aparecerá como NO ACTIVO, dejará de verse en el directorio y ya no se le generarán cuotas.\n\nEscribe el motivo de la baja:`);
        if (r === null) return;
        motivo = r;
      }
      sw.disabled = true;
      try {
        await postJson('/api/admin/members', { id, estado: next ? 'activo' : 'baja', motivo });
        sw.setAttribute('aria-checked', String(next));
        say(next ? `${name} quedó como socio activo.` : `${name} fue dado de baja.`);
      } catch (e) { say((e as Error).message, true); }
      finally { sw.disabled = false; }
    });

    saveBtn.addEventListener('click', async () => {
      saveBtn.disabled = true;
      try {
        await postJson('/api/admin/members', { id, email: email.value });
        say(`Datos de ${name} guardados.`);
      } catch (e) { say((e as Error).message, true); }
      finally { saveBtn.disabled = false; }
    });
  });
</script>
