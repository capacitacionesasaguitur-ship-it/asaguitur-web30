---
import type { DocumentItem } from '../lib/member';
import { CATEGORIAS_DOC } from '../lib/catalogs';

interface Props { documents: DocumentItem[]; active: boolean }
const { documents, active } = Astro.props;
const fmtSize = (b: number | null) => (b ? (b >= 1_048_576 ? `${(b / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`) : '');
const field = 'mt-1 w-full rounded-lg border border-navy-900/25 bg-white px-3 py-2';
---
{!active ? (
  <p class="rounded-xl border border-dashed border-navy-700/30 bg-white p-6">La biblioteca está disponible solo para socios con membresía activa.</p>
) : (
  <div>
    <div class="grid gap-4 rounded-2xl border border-navy-100 bg-white p-4 sm:grid-cols-[1fr_260px]" role="search">
      <div>
        <label for="doc-q" class="block text-sm font-semibold">Buscar por palabra clave</label>
        <input id="doc-q" type="search" placeholder="Ej. Tazumal, reglamento, mapa" autocomplete="off" class={field} />
      </div>
      <div>
        <label for="doc-cat" class="block text-sm font-semibold">Categoría</label>
        <select id="doc-cat" class={field}>
          <option value="">Todas</option>
          {Object.entries(CATEGORIAS_DOC).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
      </div>
    </div>

    <p id="doc-count" role="status" aria-live="polite" class="mt-4 text-sm font-semibold"></p>

    <ul id="doc-list" class="mt-3 grid gap-4 md:grid-cols-2">
      {documents.map((d) => (
        <li data-doc data-cat={d.category} data-text={`${d.title} ${d.description ?? ''} ${d.keywords ?? ''}`}
            class="flex flex-col rounded-2xl border border-navy-100 bg-white p-5">
          <p class="text-xs font-semibold text-magenta-700">{CATEGORIAS_DOC[d.category] ?? d.category}</p>
          <h3 class="mt-1 text-lg font-bold leading-snug">{d.title}</h3>
          {d.description && <p class="mt-1 text-sm">{d.description}</p>}
          <p class="mt-2 text-xs text-navy-900/70">PDF {fmtSize(d.file_size) && `(${fmtSize(d.file_size)})`}</p>
          <div class="mt-4 flex gap-2">
            <button type="button" data-view={d.id} data-size={d.file_size ?? 0} data-title={d.title}
                    class="rounded-lg bg-navy-700 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-900">Ver documento</button>
            <a href={`/api/member/documents/${d.id}?mode=download`} class="rounded-lg border border-navy-700 px-4 py-2 text-sm font-semibold text-navy-700 hover:bg-navy-100">Descargar</a>
          </div>
        </li>
      ))}
    </ul>
    <div id="doc-empty" class="mt-4 hidden rounded-xl border border-dashed border-navy-700/30 bg-white p-6">
      <p class="font-semibold">No encontramos documentos con esa búsqueda.</p>
      <p class="mt-1 text-sm">Prueba con otra palabra o cambia la categoría.</p>
    </div>

    <!-- Visor -->
    <dialog id="doc-dialog" class="m-auto h-[90vh] w-[min(960px,95vw)] rounded-2xl p-0 backdrop:bg-navy-900/60">
      <div class="flex h-full flex-col">
        <div class="flex items-center justify-between gap-3 border-b border-navy-100 px-4 py-3">
          <h3 id="doc-dialog-title" class="truncate font-bold"></h3>
          <button type="button" id="doc-close" class="rounded-lg border border-navy-900/25 px-3 py-1.5 text-sm font-semibold hover:bg-navy-100">Cerrar</button>
        </div>
        <iframe id="doc-frame" title="Visor del documento" class="h-full w-full flex-1"></iframe>
      </div>
    </dialog>
  </div>
)}

<script>
  const list = document.getElementById('doc-list');
  if (list) {
    const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const q = document.getElementById('doc-q') as HTMLInputElement;
    const cat = document.getElementById('doc-cat') as HTMLSelectElement;
    const count = document.getElementById('doc-count')!;
    const empty = document.getElementById('doc-empty')!;
    const items = [...list.querySelectorAll<HTMLElement>('[data-doc]')];

    const apply = () => {
      const words = norm(q.value).split(/\s+/).filter(Boolean);
      let n = 0;
      for (const el of items) {
        const text = norm(el.dataset.text ?? '');
        const ok = words.every((w) => text.includes(w)) && (!cat.value || el.dataset.cat === cat.value);
        el.classList.toggle('hidden', !ok); if (ok) n++;
      }
      count.textContent = `${n} de ${items.length} documentos`;
      empty.classList.toggle('hidden', n > 0 || items.length === 0);
    };
    q.addEventListener('input', apply); cat.addEventListener('input', apply); apply();

    const dlg = document.getElementById('doc-dialog') as HTMLDialogElement;
    const frame = document.getElementById('doc-frame') as HTMLIFrameElement;
    const MAX_VISOR = 5 * 1024 * 1024;   // el visor incrustado pasa por el servidor: archivos grandes se abren en pestaña nueva
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-view]'); if (!b) return;
      const base = `/api/member/documents/${b.dataset.view}`;
      if (Number(b.dataset.size) > MAX_VISOR) { window.open(base, '_blank', 'noopener'); return; }
      document.getElementById('doc-dialog-title')!.textContent = b.dataset.title ?? '';
      frame.src = `${base}?mode=view`; dlg.showModal();
    });
    const close = () => { dlg.close(); frame.src = 'about:blank'; };
    document.getElementById('doc-close')!.addEventListener('click', close);
    dlg.addEventListener('cancel', () => { frame.src = 'about:blank'; });
  }
</script>
