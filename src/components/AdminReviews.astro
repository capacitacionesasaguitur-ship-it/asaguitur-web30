---
interface Props { pending: any[]; approved: any[] }
const { pending, approved } = Astro.props;
const dt = new Intl.DateTimeFormat('es-SV', { dateStyle: 'medium', timeZone: 'America/El_Salvador' });
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<div>
  <p id="r-status" role="status" aria-live="polite" class="min-h-5 text-sm"></p>

  <h2 class="text-lg font-bold">Pendientes de revisión ({pending.length})</h2>
  {pending.length === 0 ? (
    <p class="mt-3 rounded-xl border border-dashed border-navy-700/30 bg-white p-5 text-sm">No hay reseñas por revisar.</p>
  ) : (
    <ul class="mt-3 grid gap-4 md:grid-cols-2">
      {pending.map((r) => (
        <li data-review={r.id} class="rounded-2xl border border-navy-100 bg-white p-4">
          <div class="flex items-start justify-between gap-3">
            <div><p class="font-semibold">{r.author_name}</p><p class="text-xs text-navy-900/70">sobre {r.guides?.full_name ?? 'guía eliminado'}, {dt.format(new Date(r.created_at))}</p></div>
            <p class="text-sol-600" aria-label={`${r.rating} de 5 estrellas`}><span aria-hidden="true">{stars(r.rating)}</span></p>
          </div>
          <p class="mt-3 whitespace-pre-line text-sm">{r.comment}</p>
          <div class="mt-4 flex gap-2">
            <button type="button" data-set="approved" class="rounded-lg bg-vigente px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Aprobar</button>
            <button type="button" data-set="rejected" class="rounded-lg border border-novigente px-4 py-2 text-sm font-semibold text-novigente hover:bg-novigente-100">Rechazar</button>
          </div>
        </li>
      ))}
    </ul>
  )}

  <details class="mt-8">
    <summary class="cursor-pointer text-lg font-bold">Aprobadas recientemente ({approved.length})</summary>
    <ul class="mt-3 grid gap-4 md:grid-cols-2">
      {approved.map((r) => (
        <li data-review={r.id} class="rounded-2xl border border-navy-100 bg-white p-4">
          <div class="flex items-start justify-between gap-3">
            <div><p class="font-semibold">{r.author_name}</p><p class="text-xs text-navy-900/70">sobre {r.guides?.full_name ?? 'guía eliminado'}, {dt.format(new Date(r.created_at))}</p></div>
            <p class="text-sol-600" aria-label={`${r.rating} de 5 estrellas`}><span aria-hidden="true">{stars(r.rating)}</span></p>
          </div>
          <p class="mt-3 whitespace-pre-line text-sm">{r.comment}</p>
          <button type="button" data-set="rejected" class="mt-4 rounded-lg border border-novigente px-4 py-2 text-sm font-semibold text-novigente hover:bg-novigente-100">Retirar de la web</button>
        </li>
      ))}
    </ul>
  </details>
</div>

<script>
  import { postJson } from '../lib/admin-client';
  const status = document.getElementById('r-status')!;
  document.querySelectorAll<HTMLButtonElement>('[data-review] [data-set]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest<HTMLElement>('[data-review]')!;
      const set = btn.dataset.set!;
      if (set === 'rejected' && !confirm('¿Rechazar esta reseña? No se mostrará en la web.')) return;
      card.querySelectorAll('button').forEach((b) => (b.disabled = true));
      try {
        await postJson('/api/admin/reviews', { id: card.dataset.review, status: set });
        card.remove();
        status.className = 'min-h-5 text-sm font-semibold text-vigente';
        status.textContent = set === 'approved' ? 'Reseña aprobada: ya es pública.' : 'Reseña rechazada.';
      } catch (e) {
        card.querySelectorAll('button').forEach((b) => (b.disabled = false));
        status.className = 'min-h-5 text-sm font-semibold text-novigente'; status.textContent = (e as Error).message;
      }
    });
  });
</script>
