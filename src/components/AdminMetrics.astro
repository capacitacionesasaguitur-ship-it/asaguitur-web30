---
import type { AdminData } from '../lib/admin-data';
interface Props { data: AdminData }
const { data } = Astro.props;

const money = new Intl.NumberFormat('es-SV', { style: 'currency', currency: 'USD' });
const dt = new Intl.DateTimeFormat('es-SV', { dateStyle: 'medium', timeZone: 'America/El_Salvador' });
const mes = (ym: string) => new Intl.DateTimeFormat('es-SV', { month: 'short', year: '2-digit' }).format(new Date(`${ym}-15T12:00:00`));

const maxMonth = Math.max(1, ...data.monthly.map((m) => m.amount));
const maxClicks = Math.max(1, ...data.clicks.map((c) => c.last_30d));
const clicks30 = data.clicks.reduce((s, c) => s + c.last_30d, 0);
const totalIngresos = data.totals.cuotas + data.totals.eventos;
---
<div class="space-y-10">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {[
      ['Ingresos (12 meses)', money.format(totalIngresos)],
      ['Cuotas pagadas', money.format(data.totals.cuotas)],
      ['Inscripciones pagadas', money.format(data.totals.eventos)],
      ['Clics a WhatsApp (30 días)', String(clicks30)],
    ].map(([k, v]) => (
      <div class="rounded-2xl border border-navy-100 bg-white p-4"><p class="text-sm text-navy-900/75">{k}</p><p class="mt-1 text-2xl font-bold">{v}</p></div>
    ))}
  </div>

  <section aria-labelledby="mi-t">
    <h2 id="mi-t" class="text-lg font-bold">Ingresos por mes (cuotas e inscripciones)</h2>
    <ul class="mt-3 space-y-1.5 rounded-2xl border border-navy-100 bg-white p-4">
      {data.monthly.map((m) => (
        <li class="grid grid-cols-[56px_1fr_90px] items-center gap-3 text-sm">
          <span class="text-navy-900/75">{mes(m.month)}</span>
          <span class="h-4 rounded bg-navy-100"><span class="block h-4 rounded bg-navy-700" style={`width:${(m.amount / maxMonth) * 100}%`}></span></span>
          <span class="text-right font-semibold">{money.format(m.amount)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="mc-t">
    <h2 id="mc-t" class="text-lg font-bold">Solicitudes por WhatsApp, por guía</h2>
    <div class="mt-3 overflow-x-auto rounded-2xl border border-navy-100 bg-white">
      <table class="w-full min-w-[560px] text-left text-sm">
        <thead class="border-b border-navy-100 text-navy-900/75">
          <tr><th scope="col" class="px-3 py-2 font-semibold">Guía</th><th scope="col" class="px-3 py-2 font-semibold">Últimos 30 días</th><th scope="col" class="px-3 py-2 text-right font-semibold">7 días</th><th scope="col" class="px-3 py-2 text-right font-semibold">Total</th></tr>
        </thead>
        <tbody class="divide-y divide-navy-100">
          {data.clicks.map((c) => (
            <tr>
              <td class="px-3 py-2"><p class="font-semibold">{c.full_name}</p><p class="text-xs text-navy-900/70">Carné {c.carnet}</p></td>
              <td class="px-3 py-2"><div class="flex items-center gap-2"><span class="h-3 w-40 rounded bg-navy-100"><span class="block h-3 rounded bg-magenta-600" style={`width:${(c.last_30d / maxClicks) * 100}%`}></span></span><span class="font-semibold">{c.last_30d}</span></div></td>
              <td class="px-3 py-2 text-right">{c.last_7d}</td>
              <td class="px-3 py-2 text-right">{c.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="me-t">
    <h2 id="me-t" class="text-lg font-bold">Eventos: inscritos e ingresos</h2>
    <div class="mt-3 overflow-x-auto rounded-2xl border border-navy-100 bg-white">
      <table class="w-full min-w-[480px] text-left text-sm">
        <thead class="border-b border-navy-100 text-navy-900/75"><tr><th scope="col" class="px-3 py-2 font-semibold">Evento</th><th scope="col" class="px-3 py-2 text-right font-semibold">Confirmados</th><th scope="col" class="px-3 py-2 text-right font-semibold">Ingresos</th></tr></thead>
        <tbody class="divide-y divide-navy-100">
          {data.eventStats.length === 0 && <tr><td colspan="3" class="px-3 py-4">Aún no hay eventos.</td></tr>}
          {data.eventStats.map((e) => (
            <tr><td class="px-3 py-2"><p class="font-semibold">{e.title}</p><p class="text-xs text-navy-900/70">{dt.format(new Date(e.starts_at))}</p></td><td class="px-3 py-2 text-right">{e.confirmed} de {e.capacity}</td><td class="px-3 py-2 text-right font-semibold">{money.format(e.revenue)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="mp-t">
    <h2 id="mp-t" class="text-lg font-bold">Últimos pagos registrados</h2>
    <div class="mt-3 overflow-x-auto rounded-2xl border border-navy-100 bg-white">
      <table class="w-full min-w-[560px] text-left text-sm">
        <thead class="border-b border-navy-100 text-navy-900/75"><tr><th scope="col" class="px-3 py-2 font-semibold">Fecha</th><th scope="col" class="px-3 py-2 font-semibold">Socio</th><th scope="col" class="px-3 py-2 font-semibold">Concepto</th><th scope="col" class="px-3 py-2 text-right font-semibold">Monto</th></tr></thead>
        <tbody class="divide-y divide-navy-100">
          {data.paid.length === 0 && <tr><td colspan="4" class="px-3 py-4">Aún no hay pagos registrados.</td></tr>}
          {data.paid.slice(0, 25).map((p) => (
            <tr><td class="px-3 py-2 whitespace-nowrap">{dt.format(new Date(`${p.fecha_pago}T12:00:00Z`))}</td><td class="px-3 py-2">{p.guides?.full_name ?? 'Socio eliminado'}</td><td class="px-3 py-2">{p.description}</td><td class="px-3 py-2 text-right font-semibold">{money.format(p.amount)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>
