---
import type { Member, Payment, Cuota, Cuenta } from '../lib/member';

interface Props { member: Member; payments: Payment[]; cuotas: Cuota[]; cuenta: Cuenta | null; pagosInfo?: string }
const { member, payments, cuotas, cuenta, pagosInfo } = Astro.props;

const money = new Intl.NumberFormat('es-SV', { style: 'currency', currency: 'USD' });
const dt = new Intl.DateTimeFormat('es-SV', { dateStyle: 'medium', timeZone: 'UTC' });
const mes = new Intl.DateTimeFormat('es-SV', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const hoyISO = new Date().toLocaleDateString('en-CA', { timeZone: 'America/El_Salvador' });

const inactivo = member.estado === 'inactivo_mora';
const pendiente = member.estado === 'pendiente';
const ESTADO = pendiente
  ? { texto: 'Pendiente de activación', chip: 'bg-sol-400 text-navy-900', nota: 'Tus cuotas comienzan cuando la Junta Directiva active tu cuenta. Por ahora no tienes nada que pagar.' }
  : inactivo
  ? { texto: 'Inactivo por mora', chip: 'bg-novigente text-white', nota: 'Tu cuenta se reactiva automáticamente cuando, con tus pagos, te queden 2 cuotas vencidas o menos.' }
  : {
      al_dia: { texto: 'Al día', chip: 'bg-vigente text-white', nota: 'No tienes cuotas vencidas. Gracias por tu aporte.' },
      pendiente: { texto: 'Pendiente', chip: 'bg-sol-400 text-navy-900', nota: 'Tienes cuotas vencidas. Ponte al día para mantener tu membresía activa.' },
      en_mora: { texto: 'En mora', chip: 'bg-novigente text-white', nota: 'Tienes varias cuotas vencidas. Regulariza tu saldo para evitar que tu cuenta pase a inactiva.' },
    }[member.finance_status];

const estadoCuota = (c: Cuota) => {
  if (c.pagado >= c.monto) return { t: 'Pagada', cls: 'text-vigente' };
  const vencida = `${c.periodo.slice(0, 8)}25` < hoyISO;           // las cuotas vencen el día 25 de su mes
  if (c.pagado > 0) return { t: vencida ? 'Parcial · vencida' : 'Parcial', cls: vencida ? 'text-novigente' : 'text-navy-900' };
  return vencida ? { t: 'Vencida', cls: 'text-novigente' } : { t: 'Vence el 25', cls: 'text-navy-900' };
};
const instrucciones = (pagosInfo ?? '').replace(/\\n/g, '\n').trim();
---
<div class="grid gap-6 lg:grid-cols-[360px_1fr]">
  <div class="space-y-6">
    <section class="rounded-2xl border border-navy-100 bg-white p-5" aria-labelledby="estado-titulo">
      <h2 id="estado-titulo" class="text-lg font-bold">Estado de cuenta</h2>
      <p class="mt-3"><span class={`inline-block rounded-full px-3 py-1 text-sm font-bold ${ESTADO.chip}`}>{ESTADO.texto}</span></p>
      {cuenta && (
        <dl class="mt-4 space-y-3 text-sm">
          <div><dt class="text-navy-900/75">Saldo vencido</dt><dd class="text-2xl font-bold">{money.format(cuenta.saldo_vencido)}</dd></div>
          <div class="flex justify-between gap-4 border-t border-navy-100 pt-3"><dt class="text-navy-900/75">Cuotas vencidas</dt><dd class="font-semibold">{cuenta.meses_mora}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-navy-900/75">Pendiente de todo el año</dt><dd class="font-semibold">{money.format(cuenta.saldo_total)}</dd></div>
          {cuenta.saldo_a_favor > 0 && <div class="flex justify-between gap-4"><dt class="text-navy-900/75">Saldo a tu favor</dt><dd class="font-semibold text-vigente">{money.format(cuenta.saldo_a_favor)}</dd></div>}
        </dl>
      )}
      <p class="mt-4 text-sm">{ESTADO.nota}</p>
    </section>

    <section class="rounded-2xl border border-navy-100 bg-white p-5" aria-labelledby="como-titulo">
      <h2 id="como-titulo" class="text-lg font-bold">Cómo pagar</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm">
        <li>Realiza tu pago en el banco. Puedes pagar la cuota completa, por meses o en pagos parciales.</li>
        <li>Envía tu comprobante a la Tesorería de ASAGUITUR.</li>
        <li>Recibirás tu recibo por correo y verás tu saldo actualizado aquí.</li>
      </ol>
      {instrucciones && <p class="mt-3 whitespace-pre-line rounded-lg bg-fondo px-3 py-2 text-sm">{instrucciones}</p>}
    </section>
  </div>

  <div class="space-y-6">
    <section class="rounded-2xl border border-navy-100 bg-white p-5" aria-labelledby="cuotas-titulo">
      <h2 id="cuotas-titulo" class="text-lg font-bold">Mis cuotas</h2>
      {cuotas.length === 0 ? (
        <p class="mt-4 rounded-xl border border-dashed border-navy-700/30 p-5 text-sm">Aún no hay cuotas generadas.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[420px] text-left text-sm">
            <thead class="border-b border-navy-100 text-navy-900/75">
              <tr><th scope="col" class="py-2 pr-3 font-semibold">Mes</th><th scope="col" class="py-2 pr-3 text-right font-semibold">Cuota</th><th scope="col" class="py-2 pr-3 text-right font-semibold">Pagado</th><th scope="col" class="py-2 font-semibold">Estado</th></tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              {cuotas.map((c) => { const e = estadoCuota(c); return (
                <tr>
                  <td class="py-2.5 pr-3 capitalize">{mes.format(new Date(`${c.periodo}T12:00:00Z`))}</td>
                  <td class="py-2.5 pr-3 text-right">{money.format(c.monto)}</td>
                  <td class="py-2.5 pr-3 text-right">{money.format(c.pagado)}</td>
                  <td class={`py-2.5 font-semibold ${e.cls}`}>{e.t}</td>
                </tr>); })}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="rounded-2xl border border-navy-100 bg-white p-5" aria-labelledby="hist-titulo">
      <h2 id="hist-titulo" class="text-lg font-bold">Historial de pagos y recibos</h2>
      {payments.length === 0 ? (
        <p class="mt-4 rounded-xl border border-dashed border-navy-700/30 p-5 text-sm">Aún no hay pagos registrados.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead class="border-b border-navy-100 text-navy-900/75">
              <tr><th scope="col" class="py-2 pr-3 font-semibold">Fecha</th><th scope="col" class="py-2 pr-3 font-semibold">Concepto</th><th scope="col" class="py-2 pr-3 text-right font-semibold">Monto</th><th scope="col" class="py-2 font-semibold">Recibo</th></tr>
            </thead>
            <tbody class="divide-y divide-navy-100">
              {payments.map((p) => (
                <tr class={p.status === 'voided' ? 'text-navy-900/55' : ''}>
                  <td class="py-2.5 pr-3 whitespace-nowrap">{dt.format(new Date(`${(p.fecha_pago ?? p.created_at).slice(0, 10)}T12:00:00Z`))}</td>
                  <td class="py-2.5 pr-3">{p.description}{p.referencia && <span class="block text-xs text-navy-900/70">Ref. {p.referencia}</span>}</td>
                  <td class={`py-2.5 pr-3 text-right whitespace-nowrap ${p.status === 'voided' ? 'line-through' : ''}`}>{money.format(p.amount)}</td>
                  <td class="py-2.5 whitespace-nowrap">
                    <a href={`/api/member/recibo/${p.id}`} target="_blank" rel="noopener" class="font-semibold text-navy-700 underline">{p.recibo_numero}</a>
                    {p.status === 'voided' && <span class="ml-2 rounded-full bg-novigente px-2 py-0.5 text-xs font-bold text-white">Anulado</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</div>
