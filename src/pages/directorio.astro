---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { getGuides } from '../lib/guides';

const guides = await getGuides();
const uniq = (xs: string[]) => [...new Set(xs)].sort((a, b) => a.localeCompare(b, 'es'));
const idiomas = uniq(guides.flatMap((g) => g.languages));
const especialidades = uniq(guides.flatMap((g) => g.specialties));
const departamentos = uniq(guides.map((g) => g.department));

const selectCls = 'w-full rounded-lg border border-navy-900/25 bg-white px-3 py-2';
---
<BaseLayout title="Directorio de guías">
  <main class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold text-navy-700 sm:text-4xl">Directorio de guías</h1>
    <p class="mt-2 max-w-2xl">Socios de ASAGUITUR con carné vigente. Filtra y escribe directo al guía.</p>

    <form id="filters" class="mt-8 grid gap-4 rounded-2xl border border-navy-100 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4" role="search" onsubmit="return false">
      <div class="sm:col-span-2 lg:col-span-4">
        <label for="q" class="block text-sm font-semibold">Buscar por nombre</label>
        <input id="q" type="search" placeholder="Ej. María Alvarado" autocomplete="off" class={`mt-1 ${selectCls}`} />
      </div>
      <div>
        <label for="f-idioma" class="block text-sm font-semibold">Idioma</label>
        <select id="f-idioma" class={`mt-1 ${selectCls}`}>
          <option value="">Todos</option>
          {idiomas.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
      <div>
        <label for="f-especialidad" class="block text-sm font-semibold">Especialidad</label>
        <select id="f-especialidad" class={`mt-1 ${selectCls}`}>
          <option value="">Todas</option>
          {especialidades.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
      <div>
        <label for="f-depto" class="block text-sm font-semibold">Departamento</label>
        <select id="f-depto" class={`mt-1 ${selectCls}`}>
          <option value="">Todos</option>
          {departamentos.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
      <div class="flex items-end">
        <button id="clear" type="button" class="w-full rounded-lg border border-navy-700 px-3 py-2 font-semibold text-navy-700 hover:bg-navy-100">
          Limpiar filtros
        </button>
      </div>
    </form>

    <p id="count" role="status" aria-live="polite" class="mt-6 text-sm font-semibold"></p>

    <ul id="grid" class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((g) => (
        <li data-guide
            data-name={g.full_name}
            data-languages={g.languages.join('|')}
            data-specialties={g.specialties.join('|')}
            data-department={g.department}>
          <GuideCard guide={g} />
        </li>
      ))}
    </ul>

    <div id="empty" class="mt-6 hidden rounded-xl border border-dashed border-navy-700/30 p-6">
      <p class="font-semibold">Ningún guía coincide con tu búsqueda.</p>
      <p class="mt-1">Prueba con otro nombre o quita algún filtro.</p>
    </div>
  </main>
</BaseLayout>

<script>
  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const q = $<HTMLInputElement>('q');
  const idioma = $<HTMLSelectElement>('f-idioma');
  const especialidad = $<HTMLSelectElement>('f-especialidad');
  const depto = $<HTMLSelectElement>('f-depto');
  const count = $('count');
  const empty = $('empty');
  const items = [...document.querySelectorAll<HTMLElement>('#grid [data-guide]')];

  function apply() {
    const term = norm(q.value);
    let visible = 0;
    for (const el of items) {
      const ok =
        (!term || norm(el.dataset.name ?? '').includes(term)) &&
        (!idioma.value || (el.dataset.languages ?? '').split('|').includes(idioma.value)) &&
        (!especialidad.value || (el.dataset.specialties ?? '').split('|').includes(especialidad.value)) &&
        (!depto.value || el.dataset.department === depto.value);
      el.classList.toggle('hidden', !ok);
      if (ok) visible++;
    }
    count.textContent = `${visible} de ${items.length} guías`;
    empty.classList.toggle('hidden', visible > 0);
  }

  [q, idioma, especialidad, depto].forEach((c) => c.addEventListener('input', apply));
  $('clear').addEventListener('click', () => {
    q.value = ''; idioma.value = ''; especialidad.value = ''; depto.value = '';
    apply(); q.focus();
  });
  apply();
</script>
