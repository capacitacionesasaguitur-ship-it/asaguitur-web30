---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Guías turísticos con carné oficial">
  <main class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="max-w-2xl text-4xl font-bold leading-tight text-navy-700 sm:text-5xl">
      Guías turísticos de El Salvador, con carné y registro vigente.
    </h1>
    <p class="mt-4 max-w-xl text-lg">
      Busca por idioma, especialidad o departamento y escribe directo al guía por WhatsApp.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/directorio" class="inline-block rounded-xl bg-navy-700 px-6 py-3 font-semibold text-white hover:bg-navy-900">
        Ver directorio de guías
      </a>
      <a href="/institucional" class="inline-block rounded-xl border border-navy-700 px-6 py-3 font-semibold text-navy-700 hover:bg-navy-100">
        Conoce a ASAGUITUR
      </a>
    </div>
  </main>
</BaseLayout>
