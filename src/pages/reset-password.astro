---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = false;
const ERR: Record<string, string> = {
  corta: 'La contraseña debe tener al menos 8 caracteres.',
  distinta: 'Las contraseñas no coinciden.',
  fallo: 'No pudimos actualizar la contraseña. Solicita un enlace nuevo.',
};
const error = ERR[Astro.url.searchParams.get('error') ?? ''];
const input = 'mt-1 w-full rounded-lg border border-navy-900/25 bg-white px-3 py-2.5';
---
<BaseLayout title="Nueva contraseña" noindex>
  <main class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-3xl font-bold text-navy-700">Crea tu contraseña</h1>
    <p class="mt-2">Elige una contraseña de al menos 8 caracteres.</p>
    {error && <p role="alert" class="mt-5 rounded-lg border border-novigente bg-novigente-100 px-4 py-3 text-sm font-medium text-novigente">{error}</p>}
    <form method="post" action="/api/auth/update-password" class="mt-6 space-y-4 rounded-2xl border border-navy-100 bg-white p-6">
      <div>
        <label for="password" class="block text-sm font-semibold">Contraseña nueva</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class={input} />
      </div>
      <div>
        <label for="confirm" class="block text-sm font-semibold">Repite la contraseña</label>
        <input id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password" class={input} />
      </div>
      <button class="w-full rounded-xl bg-navy-700 px-5 py-3 font-semibold text-white hover:bg-navy-900">Guardar contraseña</button>
    </form>
  </main>
</BaseLayout>
