# ASAGUITUR · variables de entorno
# Local: copia este archivo como ".env". En producción se cargan en Netlify (Site configuration → Environment variables).

# ---------- Supabase (Project Settings → API) ----------
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SECRETA. Solo servidor. Nunca con prefijo PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---------- Sitio ----------
# URL pública final, sin barra al final. Se usa en el QR del carné, en los correos.
PUBLIC_SITE_URL=https://www.asaguitur.org

# ---------- Pagos manuales ----------
# Texto que ve el socio en "Cómo pagar" (cuenta del banco, titular, a dónde enviar el comprobante).
# Una sola línea; usa \n para separar renglones. La cuota ($3.00) y los plazos se cambian en la tabla public.config.
PAGOS_INSTRUCCIONES=Banco: NOMBRE DEL BANCO\nCuenta: 0000000000 (tipo)\nA nombre de: Asociación Salvadoreña de Guías Turísticos\nEnvía tu comprobante por WhatsApp al 0000-0000 o a tesoreria@asaguitur.org

# ---------- Tarea diaria (cuotas, mora y avisos) ----------
# Clave larga y secreta (mínimo 16 caracteres). La misma que lee netlify/functions/cron-diario.mjs.
CRON_SECRET=

# ---------- Resend (resend.com → API Keys) ----------
RESEND_API_KEY=
RESEND_FROM=ASAGUITUR <comunicaciones@asaguitur.org>
RESEND_REPLY_TO=
